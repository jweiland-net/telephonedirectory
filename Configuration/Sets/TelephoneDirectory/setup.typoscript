plugin.tx_telephonedirectory {
    view {
        templateRootPaths {
            0 = EXT:telephonedirectory/Resources/Private/Templates/
            1 = {$telephonedirectory.templateRootPath}
        }

        partialRootPaths {
            0 = EXT:telephonedirectory/Resources/Private/Partials/
            1 = {$telephonedirectory.partialRootPath}
        }

        layoutRootPaths {
            0 = EXT:telephonedirectory/Resources/Private/Layouts/
            1 = {$telephonedirectory.layoutRootPath}
        }
    }

    persistence {
        storagePid = {$telephonedirectory.storagePid}
    }

    features {
        # uncomment the following line to enable the new Property Mapper.
        rewrittenPropertyMapper = 1
    }

    settings {
      pidOfDetailPage = {$telephonedirectory.pidOfDetailPage}
      pageBrowser {
          itemsPerPage = {$telephonedirectory.pageBrowser.itemsPerPage}
          insertAbove = {$telephonedirectory.pageBrowser.insertAbove}
          insertBelow = {$telephonedirectory.pageBrowser.insertBelow}
          maximumNumberOfLinks = {$telephonedirectory.pageBrowser.maximumNumberOfLinks}
      }
      new {
          uploadFolder = 1:user_upload/tx_telephonedirectory/
      }
    }
}

plugin.tx_telephonedirectory._CSS_DEFAULT_STYLE (
	textarea.f3-form-error {
		background-color:#FF9F9F;
		border: 1px #FF0000 solid;
	}

	input.f3-form-error {
		background-color:#FF9F9F;
		border: 1px #FF0000 solid;
	}
)

page.includeJSFooterlibs {
  telephonedirectoryEditAction = EXT:telephonedirectory/Resources/Public/JavaScript/EditAction.js
}
